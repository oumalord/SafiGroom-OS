{
    "name": "safigroom-os",
    "private": true,
    "version": "1.0.0",
    "description": "SafiGroom OS salon management app",
    "author": "SafiGroom",
    "type": "module",
    "main": "desktop/main.cjs",
    "scripts": {
        "dev": "vite",
        "server": "tsx backend/server.ts",
        "db:bootstrap": "tsx database/apply-neon.ts",
        "db:migrate-branches": "tsx database/migrate-branches.ts",
        "db:migrate-payment-methods": "tsx database/migrate-payment-methods.ts",
        "db:clone-branch": "tsx database/clone-branch-data.ts",
        "db:purge-demo": "tsx database/purge-demo.ts",
        "db:set-platform-admin": "tsx database/set-platform-admin.ts",
        "db:clean-reset-admin": "tsx database/clean-reset-admin.ts",
        "build": "node ./node_modules/vite/bin/vite.js build",
        "preview": "vite preview",
        "desktop:dist": "electron-builder --win nsis",
        "android:sync": "node scripts/build-android.mjs",
        "android:open": "cap open android"
    },
    "dependencies": {
        "@capacitor/android": "^7.4.3",
        "@capacitor/core": "^7.4.3",
        "@neondatabase/serverless": "^1.1.0",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "lucide-react": "^0.469.0",
        "qrcode": "^1.5.4",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "^4.0.0"
    },
    "devDependencies": {
        "@capacitor/cli": "^7.4.3",
        "electron": "^45.3.2",
        "electron-builder": "^26.0.12",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^4.3.0",
        "autoprefixer": "^10.4.0",
        "postcss": "^8.4.0",
        "tailwindcss": "^3.4.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.0",
        "vite": "^6.0.0",
        "vite-plugin-pwa": "^1.0.3"
    },
    "build": {
        "appId": "com.safigroom.os.desktop",
        "productName": "SafiGroom OS",
        "directories": {
            "output": "release"
        },
        "files": [
            "app-config.json",
            "desktop/**/*",
            "build/**/*",
            "package.json"
        ],
        "win": {
            "target": ["nsis"],
            "icon": "build/safigroom.ico"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        }
    }
}
